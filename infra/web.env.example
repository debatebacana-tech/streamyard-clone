# Copie para infra/web.env (NÃO commitar) antes de subir os containers.
# docker-compose lê este arquivo via `env_file:` no serviço `web`.

HOST_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-string-aleatoria-de-32-chars-ou-mais
ENCRYPTION_KEY=troque-por-outra-string-aleatoria

DATABASE_URL="file:/app/data/show.db"

# Precisam bater exatamente com a chave/segredo em livekit.yaml e egress.yaml
LIVEKIT_API_KEY=REPLACE_WITH_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_API_SECRET_32_CHARS_MIN

# Dentro da rede do docker-compose, o app fala com o LiveKit pelo nome do serviço
LIVEKIT_HTTP_URL=http://livekit:7880

# URL que o worker do Egress usa para carregar a página de layout — como ele
# está na mesma rede do compose, usa o nome do serviço, não o domínio público
PUBLIC_APP_URL=http://web:3000
